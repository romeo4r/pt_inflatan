<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Enables `dotnet user-secrets` for local connection strings; nothing is stored in the repo. -->
    <UserSecretsId>mundialito-api-7f3c2a9e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Design-time only: required by `dotnet ef` when this project is the startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mundialito.Application\Mundialito.Application.csproj" />
    <ProjectReference Include="..\Mundialito.Infrastructure\Mundialito.Infrastructure.csproj" />
  </ItemGroup>

</Project>
