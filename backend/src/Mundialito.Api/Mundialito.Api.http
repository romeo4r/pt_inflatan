@host = http://localhost:5000

### Health (API + database)
GET {{host}}/health
Accept: application/json

### Correlation id round-trip
GET {{host}}/health
X-Correlation-Id: demo-123

### OpenAPI document
GET {{host}}/openapi/v1.json

### ---------------- Teams ----------------

### List teams (paged, sorted)
GET {{host}}/api/teams?pageNumber=1&pageSize=10&sortBy=name&sortDirection=asc

### List teams: search + active filter
GET {{host}}/api/teams?search=fin&isActive=true

### List teams: invalid sort key -> 400 validation problem
GET {{host}}/api/teams?sortBy=password

### Create team -> 201 + Location (Idempotency-Key is required)
# @name createTeam
POST {{host}}/api/teams
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "name": "Finanzas FC",
  "code": "fin",
  "coach": "Ana Pérez"
}

### Create without Idempotency-Key -> 400 Idempotency.KeyRequired
POST {{host}}/api/teams
Content-Type: application/json

{
  "name": "Sin llave",
  "code": "SIN"
}

### Idempotency replay: same key + same body twice -> both 201, second has Idempotent-Replayed: true
POST {{host}}/api/teams
Content-Type: application/json
Idempotency-Key: demo-replay-001

{
  "name": "Tecnología City",
  "code": "TEC"
}

### Same key with a different body -> 409 Idempotency.PayloadMismatch
POST {{host}}/api/teams
Content-Type: application/json
Idempotency-Key: demo-replay-001

{
  "name": "Otro nombre",
  "code": "OTR"
}

### Create duplicate code -> 409 Team.CodeAlreadyExists
POST {{host}}/api/teams
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "name": "Finanzas duplicado",
  "code": "FIN"
}

### Create invalid -> 400 with field errors
POST {{host}}/api/teams
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "name": "",
  "code": "F-1"
}

### Get team by id -> 200 + ETag header
# @name getTeam
GET {{host}}/api/teams/{{createTeam.response.body.id}}

### Replace team (PUT) with If-Match -> 200 (409 Concurrency.Conflict if someone changed it in between)
PUT {{host}}/api/teams/{{createTeam.response.body.id}}
Content-Type: application/json
If-Match: {{getTeam.response.headers.ETag}}

{
  "name": "Finanzas FC",
  "code": "FIN",
  "coach": "Luis Mejía",
  "isActive": true
}

### Replace again with the OLD ETag -> 409 Concurrency.Conflict
PUT {{host}}/api/teams/{{createTeam.response.body.id}}
Content-Type: application/json
If-Match: {{getTeam.response.headers.ETag}}

{
  "name": "Finanzas FC",
  "code": "FIN",
  "coach": "Carlos Ruiz",
  "isActive": true
}

### Partial update (PATCH) without If-Match: clear the coach only
PATCH {{host}}/api/teams/{{createTeam.response.body.id}}
Content-Type: application/json

{
  "coach": ""
}

### Delete team -> 204 (repeat: still 204)
DELETE {{host}}/api/teams/{{createTeam.response.body.id}}

### Get deleted team -> 404
GET {{host}}/api/teams/{{createTeam.response.body.id}}

###

### ---------------- Players ----------------

### Register a player in a team -> 201 (Idempotency-Key required)
# @name createPlayer
POST {{host}}/api/teams/{{createTeam.response.body.id}}/players
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "firstName": "Carlos",
  "lastName": "Gómez",
  "jerseyNumber": 9,
  "position": "Forward",
  "birthDate": "1995-05-20"
}

### Same jersey number in the same team -> 409 Player.JerseyNumberTaken
POST {{host}}/api/teams/{{createTeam.response.body.id}}/players
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "firstName": "Otro",
  "lastName": "Jugador",
  "jerseyNumber": 9,
  "position": "Defender"
}

### Invalid player -> 400 with field errors
POST {{host}}/api/teams/{{createTeam.response.body.id}}/players
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "firstName": "",
  "lastName": "X",
  "jerseyNumber": 0,
  "position": "Striker"
}

### Players of a team
GET {{host}}/api/teams/{{createTeam.response.body.id}}/players?sortBy=jerseyNumber

### All players, filtered by position and name
GET {{host}}/api/players?position=forward&search=gom&pageSize=5

### Get player by id -> 200 + ETag
# @name getPlayer
GET {{host}}/api/players/{{createPlayer.response.body.id}}

### Replace player (PUT) with If-Match
PUT {{host}}/api/players/{{createPlayer.response.body.id}}
Content-Type: application/json
If-Match: {{getPlayer.response.headers.ETag}}

{
  "firstName": "Carlos",
  "lastName": "Gómez",
  "jerseyNumber": 10,
  "position": "Midfielder",
  "birthDate": "1995-05-20",
  "isActive": true
}

### Partial update (PATCH): deactivate only
PATCH {{host}}/api/players/{{createPlayer.response.body.id}}
Content-Type: application/json

{
  "isActive": false
}

### Delete player -> 204 (repeat: still 204)
DELETE {{host}}/api/players/{{createPlayer.response.body.id}}

###

### ---------------- Matches ----------------
# Needs two teams. Create a second one first:
# @name createAwayTeam
POST {{host}}/api/teams
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "name": "Tecnología City",
  "code": "TEC"
}

### Schedule a match -> 201 (Idempotency-Key required)
# @name createMatch
POST {{host}}/api/matches
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "homeTeamId": "{{createTeam.response.body.id}}",
  "awayTeamId": "{{createAwayTeam.response.body.id}}",
  "matchDay": 1,
  "scheduledAtUtc": "2026-11-07T15:00:00Z",
  "venue": "Cancha Principal"
}

### Same team on both sides -> 400 (validator) 
POST {{host}}/api/matches
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "homeTeamId": "{{createTeam.response.body.id}}",
  "awayTeamId": "{{createTeam.response.body.id}}",
  "matchDay": 1,
  "scheduledAtUtc": "2026-11-07T15:00:00Z"
}

### Unknown team -> 404 Team.NotFound
POST {{host}}/api/matches
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "homeTeamId": "{{createTeam.response.body.id}}",
  "awayTeamId": "0199f000-0000-7000-8000-000000000000",
  "matchDay": 1,
  "scheduledAtUtc": "2026-11-07T15:00:00Z"
}

### List matches: by status and date range
GET {{host}}/api/matches?status=scheduled&fromUtc=2026-11-01T00:00:00Z&toUtc=2026-11-30T23:59:59Z&sortBy=scheduledAt

### List matches of a team (home or away)
GET {{host}}/api/matches?teamId={{createTeam.response.body.id}}

### Get match detail (with goals) -> 200 + ETag
# @name getMatch
GET {{host}}/api/matches/{{createMatch.response.body.match.id}}

### Reschedule (PUT) with If-Match
PUT {{host}}/api/matches/{{createMatch.response.body.match.id}}
Content-Type: application/json
If-Match: {{getMatch.response.headers.ETag}}

{
  "matchDay": 2,
  "scheduledAtUtc": "2026-11-14T15:00:00Z",
  "venue": "Cancha 2"
}

### Partial update (PATCH): venue only
PATCH {{host}}/api/matches/{{createMatch.response.body.match.id}}
Content-Type: application/json

{
  "venue": "Polideportivo"
}

### Cancel -> 200 (repeat: still 200, no change)
POST {{host}}/api/matches/{{createMatch.response.body.match.id}}/cancel

### Delete -> 204 (repeat: still 204)
DELETE {{host}}/api/matches/{{createMatch.response.body.match.id}}

###
